{% extends 'templates/visitor.twig' %}
{% import 'templates/form.twig' as form %}
{% import 'templates/departements.twig' as dep %}
{% set activemenu = 'electeur' %}

{% block subcontent %}
	<form action="{{ path_for('electeur.login.confirm.save') }}" method="POST">

		{% if election.election_infotype == 'datedepnaiss' %}
			{{ form.date(trad('date_naissance', lang),'','datenaiss') }}
			{{ dep.select(trad('dept_naissance', lang),'','depnaiss') }}
		{% elseif election.election_infotype == 'numss' %}
			{{ form.input(trad('numss', lang) ,'',trad('numss', lang),'numss') }}
        {% elseif election.election_infotype == 'matricule' %}
            {{ form.input(trad('matricule', lang) ,'',trad('matricule', lang),'matricule') }}
		{% elseif election.election_infotype == 'multiple' %}
			{{ form.input(trad('idmultiple', lang) ,'',trad('idmultiple', lang),'idmultiple') }}
		{% elseif election.election_infotype == 'defi' and election.election_question != '' %}
			{{ form.input(election.election_question,'',trad('votre_reponse', lang),'numss') }}
		{% elseif election.election_infotype == 'defi' and election.election_question == '' %}
			<div class="alert alert-danger">{{ trad('question_non_definie', lang) }}</div>
		{% elseif election.election_infotype == 'other' %}
			{{ form.input(wording.get('OTHER_PERSONAL_DATA', election.election_type),'',wording.get('OTHER_PERSONAL_DATA', election.election_type),'numss') }}
		{% else %}
			<div class="alert alert-danger">
				<span class="alert-icon">
					<i class="fa fa-exclamation-circle"></i>
				</span>
				<div>
					<p>{{ trad('second_user_inconnu', lang) }}</p>
				</div>
			</div>
		{% endif %}

		{{ form.csrf(csrf) }}
		<div class="form-group">
			<button type="submit" class="btn btn-success btn-icon w-100">
				<i class="fa fa-check"></i>{{ trad('se_connecter', lang) }}</button>
		</div>
	</form>
	<div class="form-group small">
		<a href="{{ path_for('electeur.lost') }}" class="text-secondary" aria-label="electeur lost">
			<span class="fa-stack fa-xs" aria-hidden="true">
				<i class="fa fa-circle fa-stack-2x text-secondary"></i>
				<i class="fa fa-question fa-stack-1x text-white"></i>
			</span>
			{{ trad('probleme_cnx', lang) }}</a>
	</div>
{% endblock %}
