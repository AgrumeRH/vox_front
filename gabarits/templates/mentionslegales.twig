	</div>

{% endblock %}

{% block navigation %}
    {% if area == '' %}
	    {% include 'templates/visitornav.twig' %}
    {% elseif area == 'electeur' %}
	    {% include '/electeur/navigation.twig' %}
    {% elseif area == 'observer' %}
	    {% include '/observer/navigation.twig' %}
    {% elseif area == 'manager' %}
	    {% include '/manager/navigation.twig' %}
    {% elseif area == 'admin' %}
	   {% include '/admin/navigation.twig' %}
    {% elseif area == 'expert' %}
	   {% include '/expert/navigation.twig' %}
    {% endif %}
{% endblock %}
