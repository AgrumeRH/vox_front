<!-- Modal -->
<div class="modal fade{% if autorefresh %} autorefresh{% endif %}" id="{{ id|alphanum }}" tabindex="-1" role="dialog" aria-labelledby="{{ id|alphanum }}_title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <i class="fa fa-window-maximize fa-lg gris-c"></i>
                <h5 class="modal-title" id="{{ id|alphanum }}_title">{{ title }}</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="{{ id|alphanum }}_content">
                {% block content %}{% endblock %}
            </div>
            <div class="modal-footer d-none">
                {% block footer %}{% endblock %}
            </div>
        </div>
    </div>
</div>