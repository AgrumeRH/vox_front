<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html lang="fr">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body yahoo="fix" bgcolor="#333333" style="height:100%;width:100%;padding:0;margin:0;">

<table style="max-width:100%; min-width:100%;" width="100%" cellspacing="0" cellpadding="0" border="0" align="left">
    <tbody>
    <tr style="background-color:#FFFFFF;">
        <td style="background-color:#FFFFFF;">
            <table style="max-width:600px;width:100%;" cellspacing="0" cellpadding="0" border="0" align="center">
                <tbody>
                <tr>
                    <td style="text-align:left;padding:10px;" valign="top">
                        {% if election.logo_client == 1 and election.election_logo %} 

                            <img src="{{ election.election_url }}/custom/{{ election.election_logo }}" alt="" style="max-width:200px;margin-bottom:10px;max-height:120px;" height="120"/>

                        {% else %}
                        
                            <img src="{{ election.election_url }}/img/logo-default.png" alt="" style="max-width:200px;margin-bottom:10px;max-height:120px;"/>

                        {% endif %}
                        {% block souslogo %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td style="padding:10px;color: #757575;font-family: Helvetica;font-size: 16px;line-height: 150%;text-align: left;">
                        {% block content %}{% endblock %}
                    </td>
                </tr>
                </tbody>
            </table>
        </td>
    </tr>
    <tr style="background-color:#333333;">
        <td style="background-color:#333333;padding:40px">
            <table style="max-width:600px;width:100%;" cellspacing="0" cellpadding="0" border="0" align="center">
                <tbody>
                <tr>
                    <td style="color:#FFFFFF;font-family:Helvetica;font-size:12px;line-height:150%;text-align:center;padding-top:0; padding-right:18px; padding-bottom:9px; padding-left:18px;" valign="top">
                        <em>Dans le cadre de l'organisation des élections "{{ election.election_name }}", la société Agrume a été mandatée par {{ election.election_raison }} pour mettre en place un système de vote électronique.
                            <br/><br/>
                            Cet email a été envoyé par le site {{ election.election_url }}.<br/>
                            Pour tout problème, vous pouvez contacter la cellule d'assistance au {{ election.election_phone }}.
                            <br/><br/>
                            Agrume SAS, Villa Creatis 2 rue des Mûriers CP 601 69258 LYON CEDEX 09
                        </em>
                    </td>
                </tr>
                </tbody>
            </table>
        </td>
    </tr>
    </tbody>
</table>
</body>
</html>