/*
COULEUR_TEXTE_BOUTON:#ff4fff
COULEUR_FOND_BOUTON:#400080
COULEUR_TEXTE_NAV:#005500
COULEUR_FOND_NAV:#990000
FONT_FAMILY:"Helvetica Neue", Helvetica, Arial, sans-serif
*/
.btn-primary, .btn-success, .btn-info,.custom-control-input:checked~.custom-control-label::before,.badge-pill {
color:[COULEUR_TEXTE_BOUTON]!important;
background:[COULEUR_FOND_BOUTON]!important;
border-color:[COULEUR_FOND_BOUTON]!important;
}
.navbar {
background:[COULEUR_FOND_NAV]!important;
}
li .nav-link {
color: [COULEUR_TEXTE_NAV]aa!important;
}
ul .nav-link.active {
color: [COULEUR_TEXTE_NAV]!important;
}
:not(#font-value, i) {
font-family: [FONT_FAMILY];
}