{% extends 'templates/visitor.twig' %}
{% import 'templates/form.twig' as form %}
{% set activemenu = 'electeur' %}

{% block subcontent %}
	<form action="{{ path_for('electeur.login.code.save') }}" method="POST">

        <p class="t-14">{{ trad('saisissez_code_envoye',lang) }}
            {% if election.election_code == "sms" %}
                {{ trad('par_sms_au',lang) }} {{ numtel }}
            {% elseif election.election_code == "poste" %}
                {{ trad('par_courrier',lang) }}
            {% elseif election.election_code == "email" %}
                {{ trad('par_email',lang) }}
            {% endif %}
        :</p>
         {% if election.election_code == "sms" or election.election_code == "email" %}
         <p class="t-14">
            {{ trad('conservez_code',lang) }}
         </p>
          {% endif %}
        <div class="input-group mb-3">
            <div class="input-group-prepend">
                <div class="input-group-text t-14">
                    <i class="fa fa-key fa-fw mr-1"></i> {{ trad('code_access',lang) }}
                </div>
            </div>
            <input type="password" class="form-control" id="password" name="password" placeholder="{{ infosms }}">
            <div class="input-group-append showhidepw" title=" {{ trad('afficher_masquer',lang) }}">
                <div class="input-group-text">
                    <i class="fa fa-eye fa-fw"></i>
                </div>
            </div>
        </div>

        {{ form.csrf(csrf) }}
        <div class="form-group">
            <button type="submit" class="btn btn-success btn-icon w-100">
                <i class="fa fa-check"></i> {{ trad('se_connecter',lang) }}</button>
        </div>
    
    </form>
    <div class="form-group small">
		<a href="{{ path_for('electeur.lost') }}" class="text-secondary" aria-label="problème connexion">
			<span class="fa-stack fa-xs" aria-hidden="true">
				<i class="fa fa-circle fa-stack-2x text-secondary"></i>
				<i class="fa fa-question fa-stack-1x text-white"></i>
			</span>
			 {{ trad('probleme_cnxprobleme_cnx',lang) }}</a>
	</div>
{% endblock %}